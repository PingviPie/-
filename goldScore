
const name = ["Hole-in-one!", "Eagle", "Birdie", "Par", "Bogey", "Double Bogey", "Go Home!"];
function golfScore(strokes , par){  
  if(par === 1){
  return "Hole-in-one!"
} else if (par <= strokes - 2){
  return "Eagle"
} else if (par === strokes - 1){
  return "Birdie"
} else if(par === strokes){
  return "Par"
} else if(par === strokes + 1){
  return "Bogey"
} else if (par === strokes + 2){
  return "Double Bogey"
} else if (par >= strokes + 3){
  return "Go Home!"
}
}
console.log(golfScore(1,3))
