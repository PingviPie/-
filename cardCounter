let count = 0;

function cardCounter(card) {
    // изменяем count по карте
    if ([2,3,4,5,6].includes(card)) {
        count += 1;
    } else if ([10,"J","Q","K","A"].includes(card)) {
        count -= 1;
    }

    // решаем действие
    let action = count > 0 ? "Bet" : "Hold";

    return `${count} ${action}`;
}

console.log(cardCounter(2)); // "1 Bet"
console.log(cardCounter(3)); // "2 Bet"
console.log(cardCounter(7)); // "2 Bet" (ничего не меняется)
console.log(cardCounter("K")); // "1 Bet"
console.log(cardCounter("A")); // "0 Hold"
